HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
DEEZER_API_URL=https://api.deezer.com
DATABASE_PATH=data/ubt.sqlite
LOG_LEVEL=info

# Rounds about films, series and video games: lets a Claude model tell which one each track
# comes from (names in several languages included). Without a key, only what Deezer's own
# titles and album names say is used. Each playlist is looked up once, in batches of 60 tracks.
# ANTHROPIC_API_KEY=
# SOURCE_LOOKUP_MODEL=claude-opus-5-5
